@model List<UserDto>
@{
    ViewData["Title"] = "User & Access Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Users & Access Management</h1>
        <p class="page-subtitle">Identity credentials, RBAC role assignments, and security status control</p>
    </div>
    @if (User.IsInRole(AppRoles.SuperAdmin))
    {
        <div class="d-flex gap-2">
            <a asp-action="Pending" class="btn btn-outline-warning fw-semibold shadow-sm position-relative">
                <i class="bi bi-person-check me-1"></i> Pending Approvals
                @if (ViewBag.PendingCount != null && (int)ViewBag.PendingCount > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.PendingCount</span>
                }
            </a>
            <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Create User
            </a>
        </div>
    }
</div>

@if (ViewBag.PendingCount != null && (int)ViewBag.PendingCount > 0)
{
    <div class="alert alert-warning border-0 shadow-sm d-flex justify-content-between align-items-center mb-4">
        <div>
            <i class="bi bi-person-exclamation me-2 fs-5"></i>
            <strong>@ViewBag.PendingCount Registration Request(s) Pending Approval:</strong>
            New registered user accounts are waiting for role approval by Super Admin (pranavnaik355@gmail.com).
        </div>
        @if (User.IsInRole(AppRoles.SuperAdmin))
        {
            <a asp-action="Pending" class="btn btn-warning fw-semibold btn-sm">
                <i class="bi bi-shield-check me-1"></i> Review Pending Approvals (@ViewBag.PendingCount)
            </a>
        }
    </div>
}

<!-- Search Card -->
<div class="card-modern p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by name, email, or title..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-100 fw-semibold">
                <i class="bi bi-funnel me-1"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card-modern">
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>User Identity</th>
                    <th>Role Assignment</th>
                    <th>Department</th>
                    <th>Job Title</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar me-2">@(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")</div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <div class="text-muted small">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(user.Role == AppRoles.SuperAdmin ? "bg-danger" : user.Role == AppRoles.Admin ? "bg-primary" : user.Role == AppRoles.Manager ? "bg-info text-dark" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary small fw-semibold">@(user.DepartmentName ?? "General")</span>
                            </td>
                            <td>
                                <span class="text-dark small">@(user.JobTitle ?? "Staff")</span>
                            </td>
                            <td>
                                @if (!user.IsApproved)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Approval Pending</span>
                                }
                                else if (user.IsActive)
                                {
                                    <span class="badge-pill badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-term">Deactivated</span>
                                }
                            </td>
                            <td>
                                <span class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                <span class="text-muted small">@(user.LastLoginAt?.ToString("MMM dd, HH:mm") ?? "Never")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>

                                    @if (User.IsInRole(AppRoles.SuperAdmin))
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal-@user.Id" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Delete User Modal -->
                                @if (User.IsInRole(AppRoles.SuperAdmin))
                                {
                                    <div class="modal fade text-start" id="deleteUserModal-@user.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger">Delete User Account</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    Are you sure you want to delete user account <strong>@user.FullName</strong> (@user.Email)?
                                                    This operation is permanent.
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 text-secondary d-block mb-2"></i>
                            No users found matching query.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
