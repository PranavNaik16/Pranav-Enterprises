@model ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card-modern p-5 border-danger">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-octagon" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Internal Server Error</h2>
            <p class="text-secondary mb-4">
                An unexpected condition was encountered while processing your request. The issue has been logged to the enterprise monitoring system.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-light border small text-start mb-4 font-monospace">
                    <strong>Incident Trace ID:</strong> @Model.RequestId
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
