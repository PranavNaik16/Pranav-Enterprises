@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pranav Enterprises</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var role = User.FindFirstValue(ClaimTypes.Role) ?? AppRoles.Employee;
        var fullName = User.FindFirstValue("FullName") ?? User.Identity.Name ?? "User";
        var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity.Name ?? "";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

        <div class="app-wrapper">
            <!-- Sidebar Overlay for Mobile -->
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <!-- Sidebar Navigation -->
            <aside class="app-sidebar" id="appSidebar">
                <a href="@Url.Action("Index", "Dashboard")" class="sidebar-brand">
                    <i class="bi bi-shield-check"></i>
                    <span>Pranav Enterprise</span>
                </a>

                <div class="sidebar-menu">
                    <div class="menu-header">Core Operations</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employees" ? "active" : "")" href="@Url.Action("Index", "Employees")">
                                <i class="bi bi-people"></i>
                                <span>Employees</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Projects" ? "active" : "")" href="@Url.Action("Index", "Projects")">
                                <i class="bi bi-kanban"></i>
                                <span>Projects</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Tasks" ? "active" : "")" href="@Url.Action("Index", "Tasks")">
                                <i class="bi bi-check2-square"></i>
                                <span>Tasks</span>
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin))
                    {
                        <div class="menu-header mt-3">Administration & RBAC</div>
                        <ul class="nav flex-column">
                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Pending" ? "active" : "")" href="@Url.Action("Pending", "Users")">
                                        <i class="bi bi-person-check text-warning"></i>
                                        <span>Role Approvals</span>
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Users" && ViewContext.RouteData.Values["action"]?.ToString() != "Pending" ? "active" : "")" href="@Url.Action("Index", "Users")">
                                    <i class="bi bi-person-gear"></i>
                                    <span>Users & Access</span>
                                </a>
                            </li>

                            @if (User.IsInRole(AppRoles.SuperAdmin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Roles" ? "active" : "")" href="@Url.Action("Index", "Roles")">
                                        <i class="bi bi-shield-lock"></i>
                                        <span>Roles Management</span>
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "ActivityLogs" ? "active" : "")" href="@Url.Action("Index", "ActivityLogs")">
                                    <i class="bi bi-clock-history"></i>
                                    <span>Activity Logs</span>
                                </a>
                            </li>
                        </ul>
                    }


                </div>

                <div class="sidebar-footer">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-2">@(fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U")</div>
                        <div class="overflow-hidden">
                            <div class="text-white text-truncate fw-bold" style="font-size: 0.85rem;">@fullName</div>
                            <span class="badge @(role == AppRoles.SuperAdmin ? "bg-danger" : role == AppRoles.Admin ? "bg-primary" : role == AppRoles.Manager ? "bg-info" : "bg-secondary")" style="font-size: 0.7rem;">
                                @role
                            </span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="app-main">
                <!-- Top Navigation Bar -->
                <header class="app-topbar">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm me-3 d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <span class="text-secondary small d-none d-md-inline">
                            <i class="bi bi-buildings me-1 text-primary"></i> Enterprise Operations Portal
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">


                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                    @(fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U")
                                </span>
                                <span class="d-none d-sm-inline fw-semibold small">@fullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="min-width: 200px;">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark text-truncate small">@fullName</div>
                                    <div class="text-muted text-truncate" style="font-size: 0.75rem;">@email</div>
                                    <div class="mt-1">
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@role</span>
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 small" href="@Url.Action("Profile", "Account")">
                                        <i class="bi bi-person me-2 text-primary"></i> My Profile
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 small text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="content-body">
                    <!-- Notification Alerts -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="py-3 px-4 bg-white border-top text-secondary small d-flex flex-column flex-sm-row justify-content-between align-items-center">
                    <div>
                        &copy; 2026 <strong>Pranav Enterprises</strong>. Enterprise-Grade .NET 8 Platform.
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <span class="badge bg-light text-muted border">Role-Based Access Control (RBAC) Active</span>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout (Login, Register, Error, Public) -->
        <main class="flex-grow-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container mt-3">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="container mt-3">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="container mt-3">
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <!-- Sidebar Responsive Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('appSidebar');
            const toggle = document.getElementById('sidebarToggle');
            const overlay = document.getElementById('sidebarOverlay');

            if (toggle && sidebar && overlay) {
                toggle.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    overlay.classList.toggle('show');
                });

                overlay.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
