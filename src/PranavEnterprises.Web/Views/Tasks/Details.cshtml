@model ProjectTaskDto
@{
    ViewData["Title"] = $"Task - {Model.Title}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Tasks
        </a>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">Task Code: @Model.TaskCode &bull; Project: @Model.ProjectName</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold">
                <i class="bi bi-pencil me-1"></i> Edit Task
            </a>
        }
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-light text-primary border fw-bold fs-6">@Model.TaskCode</span>
                <span class="badge @(Model.Status == TaskItemStatus.Completed ? "bg-success" : Model.Status == TaskItemStatus.InProgress ? "bg-primary" : "bg-secondary") fs-6">
                    @Model.StatusName
                </span>
            </div>

            <h5 class="fw-bold text-dark mb-2">@Model.Title</h5>
            <p class="text-secondary small mb-4">@Model.Description</p>

            <div class="row g-3 border-top pt-3">
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Parent Project</span>
                    <span class="fw-bold text-dark">@Model.ProjectName</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Assigned Resource</span>
                    <span class="fw-bold text-primary">@(Model.AssignedEmployeeName ?? "Unassigned")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Priority Level</span>
                    <span class="badge @(Model.Priority == PriorityLevel.Critical ? "bg-danger" : Model.Priority == PriorityLevel.High ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.PriorityName
                    </span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Due Date</span>
                    <span class="fw-bold text-danger">@Model.DueDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Estimated Hours</span>
                    <span class="fw-semibold">@Model.EstimatedHours hrs</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Actual Logged Hours</span>
                    <span class="fw-semibold text-success">@Model.LoggedHours hrs</span>
                </div>
            </div>

            <div class="border-top mt-4 pt-3">
                <label class="form-label fw-bold small text-secondary">Quick Status Transition</label>
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TaskItemStatus>()">
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold">Save Status</button>
                </form>
            </div>
        </div>
    </div>
</div>
