@model ProjectDto
@{
    ViewData["Title"] = $"Project - {Model.Name}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Portfolio
        </a>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">Project Code: @Model.ProjectCode &bull; Client: @Model.ClientName</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold">
                <i class="bi bi-pencil me-1"></i> Edit Project
            </a>
            <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-primary fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Add Task
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Project Details Overview -->
    <div class="col-lg-4">
        <div class="card-modern p-4">
            <h5 class="fw-bold text-dark mb-3">Project Overview</h5>
            <p class="text-secondary small mb-4">@Model.Description</p>

            <div class="mb-3">
                <div class="d-flex justify-content-between text-muted small mb-1">
                    <span>Delivery Completion</span>
                    <span class="fw-bold text-dark">@Model.ProgressPercentage%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.ProgressPercentage%;"></div>
                </div>
            </div>

            <div class="border-top pt-3">
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Current Status:</span>
                    <span class="fw-bold small text-primary">@Model.StatusName</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Priority:</span>
                    <span class="badge @(Model.Priority == PriorityLevel.Critical ? "bg-danger" : Model.Priority == PriorityLevel.High ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.PriorityName
                    </span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Project Manager:</span>
                    <span class="fw-semibold small">@Model.ManagerName</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Total Budget:</span>
                    <span class="fw-bold small text-success">$@Model.Budget.ToString("N0")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Start Date:</span>
                    <span class="fw-semibold small">@Model.StartDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Target Completion:</span>
                    <span class="fw-semibold small text-danger">@Model.EndDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
            {
                <div class="border-top mt-4 pt-3">
                    <label class="form-label fw-bold small text-secondary">Quick Status Transition</label>
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<ProjectStatus>()">
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold">Update</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Project Tasks List -->
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-header-modern">
                <h5 class="card-title-modern"><i class="bi bi-check2-square me-2 text-primary"></i> Tasks Associated With Project</h5>
                <a asp-controller="Tasks" asp-action="Index" asp-route-projectId="@Model.Id" class="small fw-semibold text-primary text-decoration-none">View All in Tasks Manager</a>
            </div>
            <div class="p-3">
                <div class="alert alert-light border small text-muted mb-0">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    This project contains <strong>@Model.TotalTasks</strong> total task(s) with <strong>@Model.CompletedTasks</strong> completed.
                    Navigate to <a asp-controller="Tasks" asp-action="Index" asp-route-projectId="@Model.Id" class="fw-semibold">Tasks Portal</a> to see details or log hours.
                </div>
            </div>
        </div>
    </div>
</div>
