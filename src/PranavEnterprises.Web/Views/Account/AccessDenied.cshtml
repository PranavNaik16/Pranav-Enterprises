@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card-modern p-5 border-danger">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">403 - Access Denied</h2>
            <p class="text-secondary mb-4">
                You do not have the necessary role permissions to access this administrative module or perform this action.
            </p>
            <div class="alert alert-light border small text-start mb-4">
                <i class="bi bi-info-circle me-1 text-primary"></i>
                If you believe this is an error, please contact your System Administrator to request an elevated role:
                <strong>Super Admin</strong>, <strong>Admin</strong>, or <strong>Manager</strong>.
            </div>
            <div class="d-flex justify-content-center gap-2">
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
