@model LoginDto
@{
    ViewData["Title"] = "Secure Login";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7 col-xl-5">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4 border-0">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle shadow-sm mb-2" style="width: 54px; height: 54px;">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Pranav Enterprises</h4>
                        <p class="mb-0 text-white-50 small">Enterprise Management & RBAC Portal</p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <h5 class="fw-bold text-dark mb-3">Sign In to Your Account</h5>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate id="loginForm">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary">Work Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0" id="emailInput" placeholder="name@pranav.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold small text-secondary">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0" id="passwordInput" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                                    <label class="form-check-label small text-secondary" for="rememberMe">Remember me</label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </button>
                        </form>

                        <!-- Quick Demo Accounts Filler -->
                        <div class="mt-4 pt-3 border-top">
                            <label class="form-label fw-bold small text-muted text-uppercase mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                Quick Demo Logins (Click to autofill):
                            </label>
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center py-1 px-3" onclick="fillCredentials('superadmin@pranav.com', 'P@ssword123!')">
                                    <span><i class="bi bi-person-fill-gear me-2"></i><strong>Super Admin</strong> (Pranav Naik)</span>
                                    <span class="badge bg-danger">Full Control</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center py-1 px-3" onclick="fillCredentials('admin@pranav.com', 'P@ssword123!')">
                                    <span><i class="bi bi-person-badge me-2"></i><strong>Admin</strong> (Amruta Naik)</span>
                                    <span class="badge bg-primary">Operations</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info text-dark text-start d-flex justify-content-between align-items-center py-1 px-3" onclick="fillCredentials('manager@pranav.com', 'P@ssword123!')">
                                    <span><i class="bi bi-briefcase me-2"></i><strong>Manager</strong> (Shubham Naik)</span>
                                    <span class="badge bg-info text-dark">Projects/Tasks</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center py-1 px-3" onclick="fillCredentials('employee@pranav.com', 'P@ssword123!')">
                                    <span><i class="bi bi-person me-2"></i><strong>Employee</strong> (Ram Naik)</span>
                                    <span class="badge bg-secondary">Standard</span>
                                </button>
                            </div>
                        </div>

                        <div class="text-center mt-4 pt-2">
                            <span class="text-muted small">Need an account? </span>
                            <a asp-action="Register" class="small fw-semibold text-primary text-decoration-none">Register New User</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}
