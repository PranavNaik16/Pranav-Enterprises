@model EmployeeDto
@{
    ViewData["Title"] = $"Employee - {Model.FullName}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-subtitle">@Model.Position &bull; @Model.DepartmentName</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold">
                <i class="bi bi-pencil me-1"></i> Edit Employee
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-modern p-4 text-center">
            <div class="avatar mx-auto mb-3" style="width: 72px; height: 72px; font-size: 1.8rem;">
                @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "E")
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-secondary small mb-2">@Model.EmployeeCode</p>
            <div class="mb-3">
                @if (Model.Status == EmployeeStatus.Active)
                {
                    <span class="badge-pill badge-active">Active Employee</span>
                }
                else if (Model.Status == EmployeeStatus.OnLeave)
                {
                    <span class="badge-pill badge-leave">On Leave</span>
                }
                else
                {
                    <span class="badge-pill badge-term">Terminated</span>
                }
            </div>

            <div class="border-top pt-3 text-start">
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Email:</span>
                    <span class="fw-semibold small">@Model.Email</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Phone:</span>
                    <span class="fw-semibold small">@(Model.Phone ?? "Not specified")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Department:</span>
                    <span class="fw-semibold small text-primary">@Model.DepartmentName</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Annual Compensation:</span>
                    <span class="fw-bold small text-success">$@Model.Salary.ToString("N0")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">Hire Date:</span>
                    <span class="fw-semibold small">@Model.HireDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-header-modern">
                <h5 class="card-title-modern"><i class="bi bi-list-task me-2 text-primary"></i> Current Assigned Tasks</h5>
                <a asp-controller="Tasks" asp-action="Create" class="btn btn-sm btn-outline-primary fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Assign New
                </a>
            </div>
            <div class="p-3">
                <div class="alert alert-light border small text-muted mb-0">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    This employee currently has <strong>@Model.ActiveTasksCount</strong> active task(s) assigned across organizational projects.
                    To view or manage all enterprise tasks, visit the <a asp-controller="Tasks" asp-action="Index" asp-route-employeeId="@Model.Id" class="fw-semibold">Tasks Portal</a>.
                </div>
            </div>
        </div>
    </div>
</div>
